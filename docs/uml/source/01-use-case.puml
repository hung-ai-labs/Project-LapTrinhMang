@startuml
!pragma layout smetana
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #40566F
skinparam classBackgroundColor #F0F6FC
skinparam componentBackgroundColor #F0F6FC
skinparam usecaseBackgroundColor #EDF6FF
skinparam actorBorderColor #29445F
skinparam sequenceMessageAlign center
left to right direction
title Weather Stream — Use Case MVP đề xuất
actor "Người xem" as Viewer
actor "Người vận hành" as Operator
actor "TCP Producer\nCollector / Simulator" as Producer
rectangle "Weather Stream Server + Web" {
  usecase "UC01\nXem thời tiết theo địa điểm" as Current
  usecase "UC02\nXem lịch sử và biểu đồ" as History
  usecase "UC03\nTiếp nhận quan sát TCP" as Ingest
  usecase "UC04\nXem cảnh báo và lịch sử" as Alerts
  usecase "UC05\nXem dự báo nhiệt độ 1 giờ" as Forecast
  usecase "UC06\nKhôi phục cập nhật realtime" as Recover
  usecase "UC07\nChuẩn bị và bật model" as Model
  usecase "Cấu hình nguồn / rule" as Config
  usecase "Kiểm tra sức khỏe hệ thống" as Health
}
Viewer --> Current
Viewer --> History
Viewer --> Alerts
Viewer --> Forecast
Viewer --> Recover
Producer --> Ingest
Operator --> Config
Operator --> Health
Operator --> Model
legend bottom
TCP Producer nằm ngoài ranh giới Server + Web.
Collector gọi provider qua HTTPS ở component diagram.
MVP xem công khai; baseline phải ghi is_ai=false.
endlegend
@enduml
