# Run from source/server. For Neon, paste its connection string and use
# postgresql+psycopg://...?...sslmode=require (preserve other Neon parameters).
DATABASE_URL=postgresql+psycopg://weather:weather@localhost:5433/weather
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
TCP_HOST=127.0.0.1
TCP_PORT=9000
ENABLE_TCP=true

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=30
WEATHER_SOURCE=provider
