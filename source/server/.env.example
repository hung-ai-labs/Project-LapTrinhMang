# Copy to .env inside source/server. Never commit real credentials.
DATABASE_URL=postgresql://weather:weather@localhost:5433/weather
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=30
WEATHER_SOURCE=provider
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
ENABLE_TCP=true
TCP_HOST=127.0.0.1
TCP_PORT=9000

# Optional collector: choose IDs OR ALL_WARDS, never both
COLLECTOR_WARD_IDS=00004
COLLECTOR_ALL_WARDS=false
COLLECTOR_MAX_PENDING=10000

# Gemini chatbot + RAG. Key at https://aistudio.google.com/apikey — never commit it.
# Leaving GEMINI_API_KEY empty keeps the server running; /api/v1/chat replies 503 instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMENSIONS=768
# Past turns replayed as context on every new message
CHAT_HISTORY_TURNS=12
CHAT_RATE_LIMIT_PER_MINUTE=10
RAG_TOP_K=5
RAG_MIN_SCORE=0.45
