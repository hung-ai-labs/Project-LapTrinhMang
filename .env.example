# Docker Compose: local PostgreSQL by default; replace with Neon URL if needed.
DATABASE_URL=postgresql+psycopg://weather:weather@db:5432/weather
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather
POSTGRES_DB=weather
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
TCP_HOST=0.0.0.0
TCP_PORT=9000
ENABLE_TCP=true
# Change host ports if another project already uses them.
POSTGRES_PORT=5433
API_PORT=8000
WEB_PORT=8080
