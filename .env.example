# Docker Compose: local PostgreSQL by default; replace with Neon URL if needed.
DATABASE_URL=postgresql://weather:weather@db:5432/weather
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather
POSTGRES_DB=weather
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
TCP_HOST=0.0.0.0
TCP_PORT=9000
ENABLE_TCP=true
# Change host ports if another project already uses them.
POSTGRES_PORT=5433
API_PORT=8000
WEB_PORT=8080

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=30
WEATHER_SOURCE=provider

# Java collector: explicit wards, comma separated
COLLECTOR_WARD_IDS=00004

# Gemini chatbot + RAG. Key at https://aistudio.google.com/apikey — never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMENSIONS=768
CHAT_HISTORY_TURNS=12
CHAT_RATE_LIMIT_PER_MINUTE=10
RAG_TOP_K=5
RAG_MIN_SCORE=0.45
